# Copy to .env and fill in real values. .env is ignored by Git.
# Generate your own random values; do not reuse any value that has appeared in Git history.

# S3-compatible storage (local SeaweedFS)
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=<your-access-key>
S3_SECRET_KEY=<your-secret-key>
S3_REGION=us-east-1
S3_BUCKET=football-raw

# Read by docker-compose.yml for the SeaweedFS container
WEED_JWT_FILER_SIGNING_KEY=<your-jwt-signing-key>
