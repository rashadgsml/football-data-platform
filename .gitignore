cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and secrets
.venv/
.env

# Local data — never commit downloaded datasets
data/raw/
data/processed/
data/*.json
data/*.parquet

# OS and editor files
.DS_Store
.vscode/
.idea/
EOF